{
  "name": "narratiaa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "install:all": "npm install --prefix apps/web && npm install --prefix tools",
    "dev": "node tools/dev.js",
    "dev:web": "npm run dev --prefix apps/web",
    "dev:api": "node tools/maven.js spring-boot:run",
    "build": "npm run build --prefix apps/web",
    "build:api": "node tools/maven.js package",
    "test": "node tools/maven.js test",
    "lint": "npm run lint --prefix apps/web",
    "start": "node tools/start.js",
    "clean": "node tools/clean.js",
    "db:start": "docker compose -f infrastructure/compose.yaml up -d database",
    "db:stop": "docker compose -f infrastructure/compose.yaml stop database",
    "db:transfer": "npm run transfer --prefix tools"
  }
}
