# Create a .env file from this example to send real verification emails with Brevo HTTPS API.
BREVO_API_KEY=xkeysib-your-api-key
EMAIL_FROM=narratiaa.app@gmail.com
EMAIL_FROM_NAME=Narratiaa

# PostgreSQL connection used by Spring Boot.
DB_HOST=localhost
DB_PORT=5434
DB_NAME=narratiaa
DB_USERNAME=narratiaa
DB_PASSWORD=narratiaa

# Set to true behind HTTPS in production.
COOKIE_SECURE=false
