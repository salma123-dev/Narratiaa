# Create a .env file from this example to send real verification emails with Gmail SMTP.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=narratiaa.app@gmail.com
MAIL_PASSWORD=your_16_character_google_app_password
EMAIL_FROM=Narratiaa <narratiaa.app@gmail.com>

# PostgreSQL connection used by Spring Boot.
DB_HOST=localhost
DB_PORT=5434
DB_NAME=narratiaa
DB_USERNAME=narratiaa
DB_PASSWORD=narratiaa

# Set to true behind HTTPS in production.
COOKIE_SECURE=false
