# Create a .env file from this example to send real verification emails.
# Get an API key and verify your sending domain in Resend.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Narratiaa <verify@your-domain.com>

# PostgreSQL connection used by Spring Boot.
DB_HOST=localhost
DB_PORT=5434
DB_NAME=narratiaa
DB_USERNAME=narratiaa
DB_PASSWORD=narratiaa

# Set to true behind HTTPS in production.
COOKIE_SECURE=false
